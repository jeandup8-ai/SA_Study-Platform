# StayScout configuration. Placeholders only — never commit real values.
# With nothing set, StayScout runs in demo mode: fictional sample data,
# deterministic planner, no payments, in-memory storage.

# --- Server ---
NODE_ENV=development
PORT=8787
# Required in production: the public origin, used for the sitemap and CSRF checks.
PUBLIC_BASE_URL=
# true only behind a proxy you control that sets X-Forwarded-For (Render, Fly, Railway…).
TRUST_PROXY=false

# --- Database (optional; in-memory if unset — trips are lost on restart) ---
# Any Postgres 13+: Neon, Supabase, Render, Railway, or local.
DATABASE_URL=
# true for most hosted Postgres providers.
DATABASE_SSL=false

# --- Places: demo | google ---
PLACES_PROVIDER=demo
# Server-side key restricted to "Places API (New)". Never use it in the browser.
GOOGLE_MAPS_API_KEY=

# --- AI planner: none | anthropic ---
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Payments: none | paypal ---
PAYMENTS_PROVIDER=none
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Live PayPal is refused unless this is true AND PAYPAL_ENV=live. Read docs/PAYPAL_SANDBOX.md first.
PAYPAL_LIVE_ENABLED=false
GUIDE_PRICE=9.00
GUIDE_CURRENCY=USD

# --- Safety sources: none | fcdo (UK FCDO travel advice via the GOV.UK Content API; no key) ---
SAFETY_PROVIDER=none
